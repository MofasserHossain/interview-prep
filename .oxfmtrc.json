{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [".next/**", "**/dist/**", "**/node_modules/**", "content/interview/**"],
  "insertFinalNewline": true,
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all"
}
