# Canonical origin for metadata, sitemap.xml, robots.txt and Open Graph images.
#
# Optional on Vercel: the stable production domain is picked up automatically
# from NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL.
#
# Set this explicitly once the site has a custom domain. No trailing slash.
# NEXT_PUBLIC_* values are inlined at build time, so a change needs a redeploy.
NEXT_PUBLIC_SITE_URL=https://interview-preperation-swe.vercel.app
